# Backend environment variables.
# Copy to `.env` for local overrides — gradle does not read .env automatically,
# but Render / Docker do via the platform's env-var configuration.

# --- Database ---------------------------------------------------------------
# For Neon, use the JDBC form (host pooled connection is fine; the suffix
# `?sslmode=require` is mandatory).
DB_URL=jdbc:postgresql://localhost:5432/taskflowdb
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT --------------------------------------------------------------------
# HS256 requires >= 32 bytes. Generate with:
#   openssl rand -hex 48
JWT_SECRET=change-me-please-this-is-a-dev-only-secret-256-bits-minimum-required-by-hs256
JWT_ACCESS_EXP_MS=900000
JWT_REFRESH_EXP_MS=1209600000

# --- CORS -------------------------------------------------------------------
# Comma-separated origin patterns. Use the deployed frontend URL in prod.
# Examples:
#   APP_CORS_ALLOWED_ORIGINS=https://taskflow-frontend.vercel.app
#   APP_CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=*

# --- Seed (default demo accounts) -------------------------------------------
APP_SEED_ENABLED=true
# SEED_MANAGER_EMAIL=manager@taskflow.local
# SEED_MANAGER_PASSWORD=Manager@123
# SEED_EMPLOYEE_EMAIL=employee@taskflow.local
# SEED_EMPLOYEE_PASSWORD=Employee@123

# --- Server -----------------------------------------------------------------
# Render injects PORT automatically; this is only used locally.
SERVER_PORT=8080
