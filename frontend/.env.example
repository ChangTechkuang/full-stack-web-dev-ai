# Frontend environment variables.
# Copy to `.env.local` for local dev; set the same vars in Vercel's
# project settings (Production / Preview / Development) for deployed builds.

# Base URL of the TaskFlow backend. Must NOT have a trailing slash.
#
# Local:       http://localhost:8080
# Render free: https://<your-service-name>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080